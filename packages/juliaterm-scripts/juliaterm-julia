#!/data/data/com.termux/files/usr/bin/sh
# JuliaTerm: start a full Julia REPL in a Debian proot container.
# Installs rootfs and juliaup on first run, then execs the Julia binary.
# The /data/data/com.termux prefix below is rewritten to the JuliaTerm package
# id (com.st0n89.juliaterm) at bootstrap build time, do not "fix" it here.
set -u

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
DISTRO=debian
PD_STATE="$PREFIX/var/lib/proot-distro"

# proot-distro >= 5.0 stores containers at containers/<name>/rootfs, older
# versions used installed-rootfs/<name>. v0.1.0 wrote the jt boot script into
# the old (empty) layout, so the login failed with "No such file or
# directory". Support both layouts.
find_rootfs() {
    if [ -d "$PD_STATE/containers/$DISTRO/rootfs" ]; then
        printf '%s\n' "$PD_STATE/containers/$DISTRO/rootfs"
    elif [ -d "$PD_STATE/installed-rootfs/$DISTRO" ]; then
        printf '%s\n' "$PD_STATE/installed-rootfs/$DISTRO"
    fi
}

command -v proot-distro >/dev/null 2>&1 || {
    echo "juliaterm: proot-distro not found (broken bootstrap?)" >&2
    exit 1
}

ROOTFS="$(find_rootfs)"
if [ -z "${ROOTFS:-}" ]; then
    echo "juliaterm: installing Debian rootfs (one-time download, ~40 MB)..."
    proot-distro install "$DISTRO" || exit 1
    ROOTFS="$(find_rootfs)"
fi
if [ -z "${ROOTFS:-}" ]; then
    echo "juliaterm: rootfs directory not found after install" >&2
    exit 1
fi
JT_DIR="$ROOTFS/root/.juliaterm"

mkdir -p "$JT_DIR"
cat > "$JT_DIR/jt" <<'EOS'
#!/bin/sh
# JuliaTerm boot script; runs inside the Debian proot container as root.
# Resolve EVERYTHING by absolute path: proot-distro's login BINDS the host
# Termux prefix into the guest AND puts it on the guest PATH. Relying on
# command -v has caused two device-side failures already:
#  - v0.1.1: 'command -v julia' found this app's own wrapper on the guest
#    PATH, re-entered proot and tripped proot-distro's nested-proot guard.
#  - v0.1.2: 'command -v curl' matched the HOST curl, so the apt fallback
#    never ran and the minimal rootfs had no CA store -> juliaup died with
#    "No CA certificates were loaded from the system".
# Check curl and the CA store by absolute path inside the guest only.
JULIA_BIN="$HOME/.juliaup/bin/julia"
if [ ! -x "$JULIA_BIN" ]; then
    echo "juliaterm: installing juliaup + Julia (one-time download, ~350 MB)..."
    if [ ! -x /usr/bin/curl ] || [ ! -f /etc/ssl/certs/ca-certificates.crt ]; then
        apt-get update -qq && apt-get install -yqq curl ca-certificates
    fi
    # Belt and braces: juliaup (rustls) reads SSL_CERT_FILE first.
    if [ -f /etc/ssl/certs/ca-certificates.crt ]; then
        export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
    fi
    curl -fsSL https://install.julialang.org | sh -s -- --yes
fi
if [ ! -x "$JULIA_BIN" ]; then
    echo "juliaterm: juliaup install failed (see messages above)." >&2
    exit 1
fi
# v0.3.0: if the host bound a chosen phone folder (drawer picker), work in it.
if [ -d /workdir ]; then
    if cd /workdir; then
        echo "juliaterm: working in /workdir (chosen phone folder)."
    else
        echo "juliaterm: cannot enter /workdir; staying in /root." >&2
    fi
fi
exec "$JULIA_BIN" "$@"
EOS
chmod 755 "$JT_DIR/jt"

mkdir -p "$HOME/.juliaterm"
touch "$HOME/.juliaterm/installed"

# v0.3.0: workdir chosen with the in-app drawer picker ("Select workdir").
# The picker writes the absolute phone path to ~/.juliaterm/workdir; bind it
# into the container as /workdir (the guest jt script then cd's there).
# Kept in a variable + separate exec branch so paths with spaces stay one
# argument to proot-distro's --bind.
JULIATERM_WORKDIR=""
if [ -s "$HOME/.juliaterm/workdir" ]; then
    JULIATERM_WORKDIR="$(head -n1 "$HOME/.juliaterm/workdir" 2>/dev/null | tr -d '\r\n')"
    if [ -d "$JULIATERM_WORKDIR" ] && [ -x "$JULIATERM_WORKDIR" ]; then
        echo "juliaterm: workdir: $JULIATERM_WORKDIR (container path: /workdir)"
    else
        echo "juliaterm: saved workdir '$JULIATERM_WORKDIR' is not accessible; starting in /root." >&2
        JULIATERM_WORKDIR=""
    fi
fi
if [ -n "$JULIATERM_WORKDIR" ]; then
    exec proot-distro login "$DISTRO" --bind "${JULIATERM_WORKDIR}:/workdir" -- /root/.juliaterm/jt "$@"
fi
exec proot-distro login "$DISTRO" -- /root/.juliaterm/jt "$@"
