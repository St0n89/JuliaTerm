JuliaTerm UI phase 1: immersive sticky fullscreen + launch branding.

Hooks the stock 'fullscreen' termux.properties property (JuliaTerm ships
true as its default runtime config) to also hide the system bars in
lean-back immersive mode, and gives the activity window a deep aubergine
background that doubles as the cold-start splash. Applied before the
fork's name replacement; adds no com.termux references.

diff --git a/termux-app/app/src/main/java/com/termux/app/TermuxActivity.java b/termux-app/app/src/main/java/com/termux/app/TermuxActivity.java
--- a/termux-app/app/src/main/java/com/termux/app/TermuxActivity.java
+++ b/termux-app/app/src/main/java/com/termux/app/TermuxActivity.java
@@ -245,7 +245,14 @@ public final class TermuxActivity extends AppCompatActivity implements ServiceCon
         content.setOnApplyWindowInsetsListener((v, insets) -> {
             mNavBarHeight = insets.getSystemWindowInsetBottom();
             return insets;
         });
 
         if (mProperties.isUsingFullScreen()) {
-            getWindow().addFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN);
+            getWindow().addFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN);
+            // JuliaTerm: lean-back immersive; system bars stay hidden until
+            // an edge swipe, then auto-hide again (sticky).
+            getWindow().getDecorView().setSystemUiVisibility(
+                View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY
+                | View.SYSTEM_UI_FLAG_LAYOUT_STABLE
+                | View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
+                | View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
+                | View.SYSTEM_UI_FLAG_HIDE_NAVIGATION
+                | View.SYSTEM_UI_FLAG_FULLSCREEN);
         }
diff --git a/termux-app/app/src/main/res/values/colors.xml b/termux-app/app/src/main/res/values/colors.xml
--- a/termux-app/app/src/main/res/values/colors.xml
